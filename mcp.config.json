{
  "mcpServers": {
    "nightforge-mcp": {
      "command": "node",
      "args": ["./nightforge/src/mcp/nightforge-mcp-server.js"],
      "env": {
        "MC_HOST": "127.0.0.1",
        "MC_PORT": "25565",
        "MC_USERNAME": "NightforgeBot",
        "MC_VERSION": "1.16.5"
      }
    },
    "yuniko-minecraft-mcp": {
      "command": "node",
      "args": [
        "./.cache/vendor/minecraft-mcp-server/dist/main.js",
        "--host",
        "127.0.0.1",
        "--port",
        "25565",
        "--username",
        "SurveyBot"
      ]
    }
  }
}
